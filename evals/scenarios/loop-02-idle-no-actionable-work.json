{
  "id": "loop-02-idle-no-actionable-work",
  "title": "An idle loop session with no actionable work is not continued",
  "plugins": [
    "loop-continuation"
  ],
  "behavior": "Every todo is completed and the operator note has no QUEUE line; the loop must end instead of re-prompting.",
  "inputs": {
    "sessions": {
      "ses_lane": {
        "messages": [
          {
            "role": "user",
            "text": "# Loop Start Command\nWork the session todo list one ticket at a time."
          }
        ],
        "todos": [
          {
            "content": "#1771 add retry to the uploader",
            "status": "completed"
          },
          {
            "content": "#1772 fix the date parser",
            "status": "completed"
          }
        ]
      }
    }
  },
  "timeline": [
    {
      "at": 0,
      "do": "idle",
      "session": "ses_lane"
    },
    {
      "at": 3600000,
      "do": "idle",
      "session": "ses_lane"
    },
    {
      "at": 7200000,
      "do": "end"
    }
  ],
  "expected": "No continuation in two simulated hours; the loop disarms with 'queue complete'.",
  "scoring": {
    "pass": [
      {
        "metric": "prompts",
        "op": "==",
        "value": 0
      },
      {
        "metric": "disarmReason",
        "op": "==",
        "value": "disarmed:queue complete"
      }
    ],
    "report": [
      "prompts",
      "disarmReason"
    ]
  }
}
